PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "M Veditor"
            VALUE "FileDescription", "M Veditor - Video and MP3 Editor"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "M Veditor"
            VALUE "LegalCopyright", "Copyright (C) M Veditor"
            VALUE "OriginalFilename", "M Veditor.exe"
            VALUE "ProductName", "M Veditor"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
